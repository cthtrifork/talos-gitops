#!/usr/bin/env bash
# Polls the plan limits of the login on the claude-home volume and serves them as Prometheus metrics on :9102/metrics.txt (PodMonitor claude-rc);
# the cockpit "Claude usage" panel reads them back from Prometheus.
# `claude remote-control` never runs a statusLine, so this asks the endpoint Claude Code's own /usage uses. It is undocumented
# (the anthropic-beta header is an internal detail) and can change; a failed poll only logs and keeps the last values, and the panel goes stale after 6 hours.
# The access token is read here, handed to curl on stdin and never printed or logged. Only the percentages and reset times leave the pod.
# Claude Code refreshes the token in place; this never refreshes it, so while the login is expired the poll answers 401 until claude runs.
set -u

creds="$HOME/.claude/.credentials.json"
interval="${POLL_INTERVAL:-300}"
usage_url=https://api.anthropic.com/api/oauth/usage
dir="${METRICS_DIR:-/var/run/usage-metrics}"

poll() {
    local tok reply code body payload
    tok="$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null)"
    [ -n "$tok" ] || { echo "no login yet"; return 1; }
    reply="$(printf 'header = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\n' "$tok" \
        | curl --silent --max-time 15 --write-out '\n%{http_code}' --config - "$usage_url")"
    tok=""
    code="${reply##*$'\n'}"
    body="${reply%$'\n'*}"
    [ "$code" = 200 ] || { echo "usage endpoint answered $code"; return 1; }
    # one line per series; a field the endpoint does not have is left out. ISO reset times become epoch seconds.
    payload="$(jq -r '
        def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
        def lines(n; w): (.[n] // {}) as $x | (
            (select($x.utilization != null) | "claude_plan_used_percent{window=\"\(w)\"} \($x.utilization)"),
            (select($x.resets_at != null) | "claude_plan_resets_at_seconds{window=\"\(w)\"} \($x.resets_at | epoch)"));
        "# TYPE claude_plan_used_percent gauge",
        "# TYPE claude_plan_resets_at_seconds gauge",
        lines("five_hour"; "five_hour"), lines("seven_day"; "seven_day")' <<<"$body" 2>/dev/null)" \
        || { echo "unexpected usage answer"; return 1; }
    grep -q '^claude_plan_used_percent' <<<"$payload" || { echo "usage answer has no limits"; return 1; }
    printf '%s\n# TYPE claude_plan_usage_polled_timestamp_seconds gauge\nclaude_plan_usage_polled_timestamp_seconds %s\n' "$payload" "$(date +%s)" >"$dir/metrics.tmp" \
        && mv "$dir/metrics.tmp" "$dir/metrics.txt"
    echo "polled: $(grep '^claude_plan_used_percent' <<<"$payload" | sed 's/claude_plan_used_percent//' | tr '\n' ' ')"
}

# serves the file; .txt gives it the text/plain Prometheus wants, and the handler does not log every scrape
python3 -I -c '
import functools, http.server, sys
class H(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a): pass
http.server.ThreadingHTTPServer(("", 9102), functools.partial(H, directory=sys.argv[1])).serve_forever()' "$dir" &

# sleep in the background so a TERM from the kubelet is handled at once
trap 'kill 0; exit 0' TERM INT
while true; do
    poll || true
    sleep "$interval" & wait $! || true
done
