{
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "tls": {
      "cert": "/etc/zot/certs/tls.crt",
      "key": "/etc/zot/certs/tls.key"
    }
  },
  "log": {
    "level": "info"
  },
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": false,
    "remoteCache": true,
    "storageDriver": {
      "name": "s3",
      "rootdirectory": "/zot",
      "region": "garage",
      "regionendpoint": "garage.registry-system.svc.cluster.local:3900",
      "bucket": "zot",
      "secure": false,
      "forcepathstyle": true
    },
    "cacheDriver": {
      "name": "redis",
      "url": "redis://valkey-zot.registry-system.svc.cluster.local:6379?addr=valkey-zot.registry-system.svc.cluster.local:6379",
      "keyprefix": "{zot}"
    },
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "1h",
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": ["buildcache/**"],
          "deleteReferrers": false,
          "deleteUntagged": true,
          "keepTags": [
            {
              "patterns": ["latest"]
            },
            {
              "patterns": [".*"],
              "mostRecentlyPushedCount": 1,
              "mostRecentlyPulledCount": 1,
              "pulledWithin": "72h",
              "pushedWithin": "72h"
            }
          ]
        },
        {
          "repositories": ["pr/**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "pushedWithin": "72h"
            }
          ]
        },
        {
          "repositories": ["ghcr-cache/**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepUntagged": {
            "mostRecentlyPushedCount": 1,
            "mostRecentlyPulledCount": 1,
            "pulledWithin": "720h",
            "pushedWithin": "720h"
          },
          "keepTags": [
            {
              "pulledWithin": "720h",
              "pushedWithin": "720h",
              "mostRecentlyPushedCount": 1
            }
          ]
        },
        {
          "repositories": ["ghcr-private/**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepUntagged": {
            "mostRecentlyPushedCount": 1,
            "mostRecentlyPulledCount": 1,
            "pulledWithin": "720h",
            "pushedWithin": "720h"
          },
          "keepTags": [
            {
              "patterns": ["latest"]
            },
            {
              "mostRecentlyPushedCount": 1,
              "mostRecentlyPulledCount": 1,
              "pulledWithin": "720h",
              "pushedWithin": "720h"
            }
          ]
        },
        {
          "repositories": ["**"],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepUntagged": {
            "mostRecentlyPushedCount": 1,
            "mostRecentlyPulledCount": 1,
            "pulledWithin": "720h",
            "pushedWithin": "720h"
          },
          "keepTags": [
            {
              "patterns": ["latest"]
            },
            {
              "mostRecentlyPushedCount": 3,
              "mostRecentlyPulledCount": 3,
              "pulledWithin": "720h",
              "pushedWithin": "720h"
            }
          ]
        }
      ]
    }
  },
  "extensions": {
    "ui": {
      "enable": true
    },
    "search": {
      "enable": true
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "sync": {
      "enable": true,
      "credentialsFile": "/etc/zot/sync/creds.json",
      "downloadDir": "/var/lib/registry/sync",
      "registries": [
        {
          "urls": [
            "https://mirror.gcr.io/library",
            "https://docker.io/library"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/docker-hub-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 1,
          "retryDelay": "5s"
        },
        {
          "urls": ["https://ghcr.io"],
          "content": [
            {
              "prefix": "/cthtrifork/**",
              "destination": "/ghcr-private"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 5,
          "retryDelay": "5s",
          "disableHTTP2": true
        },
        {
          "urls": ["https://ghcr.io"],
          "content": [
            {
              "prefix": "**",
              "destination": "/ghcr-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 5,
          "retryDelay": "5s",
          "disableHTTP2": true
        },
        {
          "urls": ["https://gcr.io"],
          "content": [
            {
              "prefix": "**",
              "destination": "/gcr-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 1,
          "retryDelay": "5s"
        },
        {
          "urls": ["https://quay.io"],
          "content": [
            {
              "prefix": "**",
              "destination": "/quay-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 1,
          "retryDelay": "5s"
        },
        {
          "urls": ["https://registry.k8s.io"],
          "content": [
            {
              "prefix": "**",
              "destination": "/k8s-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 1,
          "retryDelay": "5s"
        },
        {
          "urls": ["https://us-docker.pkg.dev"],
          "content": [
            {
              "prefix": "**",
              "destination": "/google-ar-cache"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 1,
          "retryDelay": "5s"
        }
      ]
    }
  }
}
