#!/bin/sh
# Usage: image-files ls <image> [egrep-pattern]   list file paths in the image (capped at 500 lines)
#        image-files needed <image> <path>...      list the shared libraries each ELF file links (DT_NEEDED) and the dpkg package that owns each
#        image-files cat <image> <path-in-image>   print one text file (capped at 256 KiB, or IMAGE_FILES_MAX bytes; binary files are refused)
# Streams `crane export` through tar and writes nothing to disk. File content is only printed, never executed.
set -eu
py='
import sys,tarfile,struct
want={p.lstrip("/") for p in sys.argv[1:]}
lists={};found={};links={}
tf=tarfile.open(fileobj=sys.stdin.buffer,mode="r|")
for m in tf:
    n=m.name[2:] if m.name.startswith("./") else m.name
    if n.startswith("var/lib/dpkg/info/") and n.endswith(".list") and m.isfile():
        lists[n.rsplit("/",1)[1][:-5]]={x.strip().lstrip("/") for x in tf.extractfile(m).read().decode("utf-8","replace").splitlines()}
    elif n in want:
        if m.isfile(): found[n]=tf.extractfile(m).read()
        elif m.issym(): links[n]=m.linkname
def needed(b):
    if b[:4]!=b"\x7fELF" or b[4]!=2: return None,None
    off,=struct.unpack_from("<Q",b,32);sz,num=struct.unpack_from("<HH",b,54)
    loads=[];dyn=None
    for i in range(num):
        t,f,o,v,pa,fs,ms=struct.unpack_from("<IIQQQQQ",b,off+i*sz)
        if t==1: loads.append((v,o,fs))
        if t==2: dyn=(o,fs)
    if dyn is None: return [],[]
    ent=[];o,fs=dyn
    for i in range(0,fs,16):
        tag,val=struct.unpack_from("<qQ",b,o+i)
        if tag==0: break
        ent.append((tag,val))
    def tooff(v):
        for va,o2,f2 in loads:
            if va<=v<va+f2: return o2+v-va
    st=next((v for t,v in ent if t==5),None)
    so=tooff(st) if st is not None else None
    def s(k):
        e=b.index(b"\0",so+k);return b[so+k:e].decode()
    return [s(v) for t,v in ent if t==1],[s(v) for t,v in ent if t in(15,29)]
for p in sorted(want):
    if p in links: print(p,"-> symlink to",links[p],"(use the target path)");continue
    if p not in found: print(p,"-> not in the archive");continue
    nd,rp=needed(found[p])
    if nd is None: print(p,"-> not a 64-bit ELF file");continue
    print(p,"-> static" if not nd else p+" needs:")
    for so in nd:
        pk=sorted(k for k,v in lists.items() if any(x.rsplit("/",1)[-1]==so for x in v))
        print("   ",so,"<-",",".join(pk) or "(not a dpkg file)")
    if rp: print("    rpath/runpath:",rp)
'
[ $# -ge 2 ] || { echo "usage: image-files ls <image> [pattern] | cat <image> <path> | needed <image> <path>..." >&2; exit 2; }
cmd=$1
image=$2
case $cmd in
  ls)
    crane export "$image" - | tar -t | { grep -E -- "${3:-.}" || true; } | head -n 500
    ;;
  cat)
    [ $# -eq 3 ] || { echo "usage: image-files cat <image> <path>" >&2; exit 2; }
    path=${3#/}
    data=$(crane export "$image" - | tar -xO "$path" | head -c "${IMAGE_FILES_MAX:-262144}" | LC_ALL=C tr -d '\000' || true)
    if [ -z "$data" ]; then
      echo "image-files: $path is empty, a symlink (use the target path) or not in the archive; a path through a symlinked directory (bin -> usr/bin) is stored under its target" >&2
      exit 1
    fi
    if printf '%s' "$data" | tr -d '\t\r' | LC_ALL=C grep -q '[[:cntrl:]]'; then
      echo "image-files: $path is not a text file" >&2
      exit 1
    fi
    printf '%s\n' "$data"
    ;;
  needed)
    [ $# -ge 3 ] || { echo "usage: image-files needed <image> <path>..." >&2; exit 2; }
    shift 2
    crane export "$image" - | python3 -I -c "$py" "$@"
    ;;
  *)
    echo "usage: image-files ls <image> [pattern] | cat <image> <path> | needed <image> <path>..." >&2
    exit 2
    ;;
esac
