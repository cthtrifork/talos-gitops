{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // OCIRepository urls are oci://${ZOT_MIRROR_<REGISTRY>:=<registry>}/<path>: the cluster sets the variable (zot), CI and Renovate
  // see the default, the upstream registry (see docs/registry-mirrors.md). The alias is that literal default string.
  "registryAliases": {
    "${ZOT_MIRROR_GHCR:=ghcr.io}": "ghcr.io",
    "${ZOT_MIRROR_QUAY:=quay.io}": "quay.io",
    "${ZOT_MIRROR_K8S:=registry.k8s.io}": "registry.k8s.io"
  },
  "extends": [
    "config:best-practices",
    "group:recommended"
  ],
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  // Renovate merges itself via the API (as the App, which bypasses main-protection) instead of
  // enabling GitHub native auto-merge, which does not honour the ruleset bypass.
  "platformAutomerge": false,
  // Rate limits, explicit instead of Renovate's defaults (2 PRs an hour, 10 open).
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "recreateWhen": "always",
  "pinDigests": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "commitMessageSuffix": "({{updateType}})",
  "ignorePaths": [
    "scripts/ci/**",
    "scripts/*.sh",
    "scripts/*.py",
    "k8s/**/rendered/**",
    "k8s/**/sync.yaml",
    "k8s/**/cluster.yaml"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
      "/(^|/)action\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helmfile": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "packageRules": [
    {
      "description": "Show chart names and exact versions for Flux Helm charts fetched through Zot mirrors.",
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepTypes": [
        "HelmChart"
      ],
      "matchDepNames": [
        "${ZOT_MIRROR_*}/**"
      ],
      "commitMessageTopic": "{{#each (split depName '/')}}{{#if @last}}{{{this}}}{{/if}}{{/each}} Helm chart{{#if (or isDigest isPinDigest)}} digest{{/if}}",
      "commitMessageExtra": "to {{#if (or isDigest isPinDigest)}}{{{newDigestShort}}}{{else}}{{{newValue}}}{{/if}}",
      "prBodyDefinitions": {
        "Package": "{{#each (split depName '/')}}{{#if @last}}{{{this}}}{{/if}}{{/each}}{{#if references}} ({{{references}}}){{else}}{{#if dependencyUrl}} ([package]({{{dependencyUrl}}})){{/if}}{{/if}}{{#if newName}}{{#unless (equals depName newName)}} → {{{newNameLinked}}}{{/unless}}{{/if}}"
      }
    },
    {
      "description": "Automerge patch and digest updates everywhere; more specific rules below can override",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ]
    },
    {
      "description": "The OpenVEX schema is tracked as a spec-repo commit: monthly, automerged if the VEX lint passes.",
      "matchPackageNames": [
        "https://github.com/openvex/spec"
      ],
      "schedule": [
        "* 0-5 1 * *"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "automerge": false,
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchPackageNames": [
        "/toolkit.fluxcd.io/",
        "/fluxcd/"
      ]
    },
    {
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$",
      "recreateWhen": "always"
    },
    {
      "automerge": true,
      "pinDigests": false,
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "additionalBranchPrefix": "{{depName}}-",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "matchPackageNames": [
        "cilium",
        "cilium/cilium",
        "quay.io/cilium/charts/cilium",
        "quay.io/cilium/cilium",
        "quay.io/cilium/operator",
        "quay.io/cilium/operator-generic",
        "quay.io/cilium/hubble-relay",
        "quay.io/cilium/hubble-ui",
        "quay.io/cilium/hubble-ui-backend"
      ],
      "groupName": "cilium",
      "groupSlug": "cilium",
      "automerge": false
    },
    {
      "description": "harper-pad-sync and harper-pad-admin are versioned together: the admin applies the schema, and a new sync pod is not ready until the matching admin has. One pull request moves both.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cthtrifork/harper-pad-sync",
        "ghcr.io/cthtrifork/harper-pad-admin"
      ],
      "groupName": "harper-pad images",
      "groupSlug": "harper-pad-images"
    },
    {
      "description": "The Dependency-Track api-server and frontend are released together at the same version.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mirror.gcr.io/dependencytrack/apiserver",
        "mirror.gcr.io/dependencytrack/frontend"
      ],
      "groupName": "dependency-track images",
      "groupSlug": "dependency-track-images"
    },
    {
      "description": "The CNPG image catalog keeps one image per PostgreSQL major, each tracked by the regex manager (renovate comment) with a versioning regex pinned to that major. The kubernetes and helm-values managers read the same image lines with plain docker versioning and would offer 17 -> 18 as a major bump, so those duplicates are off.",
      "matchManagers": [
        "kubernetes",
        "helm-values"
      ],
      "matchFileNames": [
        "k8s/infra/post-workloads/cnpg-system/postgresql-clusterimagecatalog.yaml"
      ],
      "enabled": false
    },
    {
      "description": "sbom-hook pulls redpandadata/connect through mirror.gcr.io, which has no digest lookup. The regex manager tracks the same tag as docker.io/redpandadata/connect (renovate comment), so the helm-values duplicate is off.",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "mirror.gcr.io/redpandadata/connect"
      ],
      "enabled": false
    },
    {
      "description": "k8s/infra/kubevirt/{kubevirt,cdi}-operator.yaml are vendored upstream release manifests (CRDs, RBAC, KUBEVIRT_VERSION). A bump of the image line alone runs a new operator on old CRDs, so they are regenerated from the release files instead (versions.env, bumped below).",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "k8s/infra/kubevirt/*-operator.yaml"
      ],
      "enabled": false
    },
    {
      "description": "KubeVirt and CDI upgrades change CRDs and RBAC: review them, no automerge. Each release (versions.env) and the digest pins of the images its operator starts (kustomization.yaml) move in one PR.",
      "matchPackageNames": [
        "kubevirt/kubevirt",
        "quay.io/kubevirt/virt-*"
      ],
      "groupName": "kubevirt",
      "groupSlug": "kubevirt",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "kubevirt/containerized-data-importer",
        "quay.io/kubevirt/cdi-*"
      ],
      "groupName": "cdi",
      "groupSlug": "cdi",
      "automerge": false
    },
    {
      "description": "The runner images built from images/ are tagged <tool version>-YYYYMMDD.<run>, a semver prerelease (docs/releasing.md): a newer build is a newer prerelease, so unstable versions must be allowed.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cthtrifork/talos-gitops/github-actions-runner",
        "ghcr.io/cthtrifork/talos-gitops/claude-runner",
        "ghcr.io/cthtrifork/talos-gitops/fileserver"
      ],
      "ignoreUnstable": false
    },
    {
      "description": "The fileserver image has two tag schemes: the old v0.x.y releases, which sort above everything and would read as an upgrade, and the current 0.0.0-<date>.<run>. Only the current one is offered.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cthtrifork/talos-gitops/fileserver"],
      "allowedVersions": "/^0\\.0\\.0-/"
    },
    {
      "description": "The tools in the Claude runner image move in one pull request, so one image build covers them. Claude Code itself stays out: its patch releases automerge, and the new image tag then reaches the pod through the claude-runner rule above.",
      "matchFileNames": ["images/claude-runner/Dockerfile"],
      "matchPackageNames": ["!@anthropic-ai/claude-code"],
      "groupName": "claude-runner tools",
      "groupSlug": "claude-runner-tools"
    },
    {
      "description": "Minor and patch updates of the runner tools automerge (the image build is the check); majors stay manual. Also wins over the fluxcd rule above for the flux tools in the Dockerfile.",
      "matchFileNames": ["images/claude-runner/Dockerfile"],
      "matchPackageNames": ["!@anthropic-ai/claude-code"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "A group's name only titles a pull request that carries several updates; with one, Renovate falls back to the bare package name (\"update dependency cli/cli\"). Name the image in the topic so a lone tool bump still reads as a runner change.",
      "matchFileNames": ["images/claude-runner/Dockerfile"],
      "matchPackageNames": ["!@anthropic-ai/claude-code"],
      "commitMessageTopic": "claude-runner tool {{{depName}}}"
    },
    {
      "description": "cli/cli is the GitHub CLI; say so in the title.",
      "matchFileNames": ["images/claude-runner/Dockerfile"],
      "matchPackageNames": ["cli/cli"],
      "commitMessageTopic": "GitHub CLI"
    },
    {
      "description": "Lit is loaded through an import map in the cockpit and usage pages: lit, lit-html, lit-element and @lit/reactive-element have to move together, or a page can end up with a lit-element that needs a newer lit-html than the map names.",
      "matchFileNames": ["k8s/apps/claude-system/cockpit/index.html", "k8s/apps/claude-system/usage/index.html"],
      "matchPackageNames": ["lit", "lit-html", "lit-element", "@lit/reactive-element"],
      "groupName": "lit",
      "groupSlug": "lit"
    },
    {
      "description": "Renovate itself (the renovate_version pin and the renovatebot/github-action) moves in one pull request and automerges for every update type, majors included. Last, so it wins over the rules above.",
      "matchPackageNames": ["renovate", "renovatebot/github-action"],
      "groupName": "renovate",
      "separateMajorMinor": false,
      "groupSlug": "renovate",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "The renovate-operator ships a new major every few weeks (v5 to v6 has a migration guide) and its CRDs run Renovate itself: a major is reviewed, not merged unseen. Last, so it wins over the rules above.",
      "matchPackageNames": ["ghcr.io/mogenius/helm-charts/renovate-operator"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Garage v2.5.0 is a one-way upgrade (the data cannot be downgraded) and release notes change bucket permissions: the chart and the image are reviewed, not merged unseen.",
      "matchPackageNames": ["ghcr.io/datahub-local/garage/garage", "dxflrs/garage"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image references in env values (the images the KubeVirt and CDI operators start), pinned by tag and digest",
      "managerFilePatterns": [
        "/^k8s/infra/kubevirt/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+value: (?<depName2>[^\\s:@]+):(?<currentValue>[-a-zA-Z0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}"
    },
    {
      "customType": "regex",
      "description": "npm packages the cockpit and usage pages load from jsDelivr, in their import map or an import (cdn.jsdelivr.net/npm/<package>@<version>/...)",
      "managerFilePatterns": [
        "/^k8s/apps/claude-system/(cockpit|usage)/index\\.html$/"
      ],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/npm/(?<depName>(?:@[^/@\"'\\s]+/)?[^/@\"'\\s]+)@(?<currentValue>[^/\"'\\s]+)/"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Catch image references with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)image:\\s+\"?(?<depName2>[^\\s:@\\\"]+)(?::(?<currentValue>[-a-zA-Z0-9.]+))?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Catch imageName references (CloudNativePG cluster chart) with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)imageName:\\s+\"?(?<depName2>[^\\s:@\\\"]+)(?::(?<currentValue>[-a-zA-Z0-9.]+))?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Catch image tags with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)tag:\\s+\"?(?<currentValue>[-a-zA-Z0-9.]+)?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}tag: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Catch version values with renovate comment (Prometheus spec.version, which must not carry a digest)",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)version:\\s+\"?(?<currentValue>v?[0-9][-a-zA-Z0-9.]*)\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}version: {{{newValue}}}"
    },
    {
      "customType": "regex",
      "description": "Pinned upstream release versions in versions.env files",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Tool versions in the images/ Dockerfiles: an ARG under a renovate comment (the dockerfile manager only reads FROM lines). The ARGs are bare versions and the download URLs add the v, so a v prefix on the release tag is dropped.",
      "managerFilePatterns": [
        "/^images/[^/]+/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\nARG [A-Z_]+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.github/.*\\.yaml$/"
      ],
      "matchStrings": [
        "[^\\s\"\\']+:\\s\"?(?<currentValue>.[^\"'\\s]*)\"?\\s+# renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.github/.*\\.yaml$/"
      ],
      "matchStrings": [
        "[A-Z_]+:\\s\"?(?<currentDigest>[a-f0-9]{40})\"?\\s+# renovate:\\s*depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "git-refs"
    }
  ]
}
